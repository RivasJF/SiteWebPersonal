---
import Layout from "../layouts/Layout.astro";

const SOCIAL_LINKS = {
  github: "https://github.com/RivasJF",
  linkedin: "https://www.linkedin.com/in/jonathan-rivas-flores-0a24223a2/",
  email: "mailto:jonyrivas2003@gmail.com"
};

const PROJECTS = [
  {
    title: "Server-Heald",
    description: "API service rest of medical appointment scheduling system.",
    tech: ["NestJS", "Prisma", "PostgreSQL", "Docker"],
    link: "https://github.com/RivasJF/Server-Heald"
  },
  {
    title: "Jessy",
    description: "Secure offline password manager mobile app with encryption, local authentication, and SQLite storage.",
    tech: ["Expo", "TypeScript", "SQLite"],
    link: "https://github.com/RivasJF/Jessy"
  },
  {
    title: "Task-Tracker-CLI",
    description: "CLI task manager with create, edit, delete, and status tracking. Uses SQLite for persistence.",
    tech: ["Node.js", "TypeScript", "SQLite", "Commander"],
    link: "https://github.com/RivasJF/Tack-Tracker-CLI"
  }
];
---

<Layout>
  <main>
    <section id="hero">
      <div class="intro">
        <p class="greeting">Hi, I'm</p>
        <h1>Jonathan Rivas Flores</h1>
        <p class="role">Backend Developer & Technical Enthusiast</p>
      </div>
      
      <div class="about">
        <p>
          22-year-old software developer from Mexico. Currently pursuing 
          Engineering in TIC's with a passion for building robust backend 
          systems and learning new technologies.
        </p>
      </div>

      <div class="social">
        <a href={SOCIAL_LINKS.github} target="_blank" aria-label="GitHub">GitHub</a>
        <a href={SOCIAL_LINKS.linkedin} target="_blank" aria-label="LinkedIn">LinkedIn</a>
      </div>
    </section>

    <section id="stack">
      <h2>Tech Stack</h2>
      <div class="stack-grid">
        <div class="stack-item">
          <h3>Backend</h3>
          <ul>
            <li>NestJS</li>
            <li>Spring Boot</li>
            <li>TypeScript</li>
            <li>Java</li>
          </ul>
        </div>
        <div class="stack-item">
          <h3>Database</h3>
          <ul>
            <li>PostgreSQL</li>
            <li>MySQL</li>
            <li>SQLite</li>
          </ul>
        </div>
        <div class="stack-item">
          <h3>Tools</h3>
          <ul>
            <li>Docker</li>
            <li>Git</li>
            <li>Github</li>
            <li>Linux</li>
          </ul>
        </div>
      </div>
    </section>

    <section id="projects">
      <h2>Projects</h2>
      <div class="projects-grid">
        {PROJECTS.map((project) => (
          <a href={project.link} class="project-card" target="_blank">
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <div class="tech-tags">
              {project.tech.map((t) => <span>{t}</span>)}
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- <section id="contact">
      <h2>Get in Touch</h2>
      <p>Interested in working together? Feel free to reach out.</p>
      <a href={SOCIAL_LINKS.email} class="cta-button">Say Hello</a>
    </section> -->
  </main>
</Layout>

<style>
  :root {
    --bg-color: #fafafa;
    --text-primary: #1a1a1a;
    --text-secondary: #666;
    --accent: #2563eb;
    --accent-hover: #1d4ed8;
    --card-bg: #ffffff;
    --border: #e5e5e5;
    --max-width: 720px;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg-color: #111;
      --text-primary: #f5f5f5;
      --text-secondary: #a3a3a3;
      --card-bg: #1a1a1a;
      --border: #2a2a2a;
    }
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    background-color: var(--bg-color);
    color: var(--text-primary);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    line-height: 1.7;
  }

  main {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }

  section {
    margin-bottom: 4rem;
  }

  h1, h2, h3 {
    font-weight: 600;
    line-height: 1.3;
  }

  h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    letter-spacing: -0.02em;
  }

  h2 {
    font-size: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  /* Hero */
  #hero {
    margin-bottom: 3rem;
  }

  .greeting {
    color: var(--accent);
    font-size: 0.875rem;
    font-weight: 500;
    margin-bottom: 0.25rem;
  }

  .role {
    color: var(--text-secondary);
    font-size: 1.125rem;
  }

  .about {
    margin: 1.5rem 0;
    color: var(--text-secondary);
    max-width: 540px;
  }

  .social {
    display: flex;
    gap: 1.5rem;
  }

  .social a {
    color: var(--text-primary);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s;
  }

  .social a:hover {
    color: var(--accent);
  }

  /* Stack */
  .stack-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1.5rem;
  }

  .stack-item {
    padding: 1.25rem;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .stack-item h3 {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
  }

  .stack-item ul {
    list-style: none;
  }

  .stack-item li {
    font-size: 0.9rem;
    margin-bottom: 0.25rem;
  }

  /* Projects */
  .projects-grid {
    display: grid;
    gap: 1rem;
  }

  .project-card {
    display: block;
    padding: 1.25rem;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    text-decoration: none;
    color: var(--text-primary);
    transition: border-color 0.2s, transform 0.2s;
  }

  .project-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .project-card h3 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }

  .project-card p {
    color: var(--text-secondary);
    font-size: 0.875rem;
    margin-bottom: 0.75rem;
  }

  .tech-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tech-tags span {
    font-size: 0.75rem;
    padding: 0.125rem 0.5rem;
    background: var(--bg-color);
    border-radius: 4px;
    color: var(--text-secondary);
  }

  /* Contact */
  #contact {
    text-align: center;
    padding: 2rem 0;
  }

  #contact p {
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .cta-button {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: var(--accent);
    color: white;
    text-decoration: none;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 500;
    transition: background 0.2s;
  }

  .cta-button:hover {
    background: var(--accent-hover);
  }
</style>
